DATABASE_URL=postgresql+psycopg://fireaware:fireaware@localhost:5432/fireaware
JWT_SECRET=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fireaware
S3_SECRET_KEY=fireaware-secret
S3_BUCKET=fireaware-photos
S3_PUBLIC_BASE_URL=http://localhost:9000/fireaware-photos
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
TRIANGULATION_RADIUS_KM=50
TRIANGULATION_TIME_WINDOW_MIN=120
CLUSTER_EPS_M=200

# Fireman accounts — the ONLY way to grant the fireman role.
# Add numbered pairs (1, 2, 3, …) and on every backend startup the matching
# user is created (or its role/password reset) from these values. Public
# /auth/register always creates civilians.
# FIREMAN_EMAIL_1=fireman.one@fireaware.dev
# FIREMAN_PASSWORD_1=change-me-please-1
# FIREMAN_EMAIL_2=fireman.two@fireaware.dev
# FIREMAN_PASSWORD_2=change-me-please-2
